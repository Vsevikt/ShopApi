{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=YOUR_SERVER;Port=YOUR_PORT;Database=YOUR_DB;Username=YOUR_USERNAME;Password=YOUR_PASSWORD"
  },
  "DirnameForFiles": {
    "Categories": "categories",
    "Products": "products"
  },
  "FileSettings": {
    "MaxProductImages": 12,
    "MaxFileSizeMb": 5,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ]
  },
  "Jwt": {
    "Key": "THIS_IS_SUPER_SECRET_KEY",
    "Issuer": "ShopApi",
    "Audience": "ShopApiClient",
    "ExpiresMinutes": 15,
    "ExpiresRefreshTokenDay": 7
  }
}
